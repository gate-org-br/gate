* {
	box-sizing: border-box;

}

:host(*) {
	gap: 12px;
	padding: 12px;
	display: flex;
	font-size: 16px;
	text-align: justify;
	align-items: stretch;
	flex-direction: column;
	justify-content: center;
	border-radius: 0 3px 3px 0;
	background-color: var(--main1, #FFFFFF);

	border: 1px solid;
	border-left: 6px solid;
	border-color: var(--main3, #DDDDDD);

}

::slotted(*) {
	margin: 0;
}

::slotted(hr) {
	margin: 0;
	width: 100%;
	opacity: 0.2;
	align-self: center;
	border: 1px solid var(--text1, #000000);
}

:host(.fill) {
	color: var(--text1, #000000);
	border-color: var(--main3, #DDDDDD);
	background-color: var(--main2, #DDDDDD);
}

:host(.success) {
	color: var(--fore-g, #5C962C);
	border-color: var(--fore-g, #5C962C);
}

:host(.success) ::slotted(hr) {
	border-color: var(--fore-g, #5C962C);
}

:host(.success.fill) {
	color: var(--text1, #FFFFFF);
	background-color: var(--back-g, #39511F);
}

:host(.warning) {
	color: var(--fore-y, #A68A0D);
	border-color: var(--fore-y, #A68A0D);
}

:host(.warning) ::slotted(hr) {
	border-color: var(--fore-y, #A68A0D);
}

:host(.warning.fill) {
	color: var(--text1, #FFFFFF);
	background-color: var(--back-y, #5C4F17);
}

:host(.danger) {
	color: var(--fore-r, #F0524F);
	border-color: var(--fore-r, #F0524F);
}

:host(.danger) ::slotted(hr) {
	border-color: var(--fore-r, #F0524F);
}

:host(.danger.fill) {
	color: var(--text1, #FFFFFF);
	background-color: var(--back-r, #772E2C);
}

:host(.question) {
	color: var(--fore-b, #3993D4);
	border-color: var(--fore-b, #3993D4);
}

:host(.question) ::slotted(hr) {
	border-color: var(--fore-b, #3993D4);
}

:host(.question.fill) {
	color: var(--text1, #FFFFFF);
	background-color: var(--back-b, #245980);
}