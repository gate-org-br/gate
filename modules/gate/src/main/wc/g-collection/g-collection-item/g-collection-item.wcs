:host {
	display: contents;
}

button {
	grid-column: 2;
	width: 44px;
	color: white;
	height: 100%;
	padding: 8px;
	border: none;
	display: flex;
	cursor: pointer;
	font-size: 12px;
	border-radius: 3px;
	align-items: center;
	text-decoration: none;
	justify-content: center;
	background-color: var(--r2, #AA2222);
}