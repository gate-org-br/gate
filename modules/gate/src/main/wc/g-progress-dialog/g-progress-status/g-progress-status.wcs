* {
	box-sizing: border-box
}

:host(*) {
	width: 100%;
	display: grid;
	padding: 10px;
	color: var(--text1);
	border-radius: 3px;
	place-items: stretch;
	place-content: stretch;
	grid-template-columns: 1fr 1fr;
	grid-template-rows: 32px 32px 32px 120px;
}

:host([status="commited"]) {
	color: var(--success1);
}

:host([status="canceled"]) {
	color: var(--error1);
}

:host([status="unknown"]) {
	color: var(--error1);
}

:host([status="error"]) {
	color: var(--warning1);
}

#title {
	display: flex;
	font-size: 20px;
	align-items: center;
	grid-column: 1 / span 2;
}

progress {
	width: 100%;
	height: 40px;
	grid-column: 1 / span 2;
}

g-digital-clock {
	display: flex;
	font-size: 12px;
	align-items: center;
}

#counter {
	display: flex;
	font-size: 12px;
	align-items: center;
	justify-content: flex-end;
}

g-logger {
	grid-column: 1 / span 2;
}