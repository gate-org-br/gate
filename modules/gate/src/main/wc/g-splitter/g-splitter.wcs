* {
	box-sizing: border-box
}

:host(*) {
	height: 100%;
	display: flex;
	min-height: 0;
	align-items: stretch;
}

div {
	flex: 1 1 50%;
	min-height: 0;
	align-self: stretch;
}

div[hidden] {
	flex-basis: 0;
	display: none;
}

button {
	padding: 0;
	width: 10px;
	border: none;

	margin: 0;
	margin-left: 4px;
	margin-right: 4px;

	cursor: col-resize;
	background-color: var(--main2, #F0F0F0);
}