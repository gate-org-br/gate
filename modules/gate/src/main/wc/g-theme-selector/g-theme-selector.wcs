* {
	box-sizing: border-box;

}

:host(*) {
	gap: 12px;
	display: flex;
	color: inherit;
	flex-shrink: 0;
	font-size: 16px;
	cursor: pointer;
	align-items: center;
	justify-content: center;
}

:host::before {
	content: '\\2140';
	font-family: 'gate';
}

:host([value='light'])::before {
	content: '\\2203';
}

:host([value='dark'])::before {
	content: '\\2164';
}