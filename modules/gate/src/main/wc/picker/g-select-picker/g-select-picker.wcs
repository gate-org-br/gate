dialog
{
	height: fit-content;
	width: clamp(320px, calc(100% - 120px), 1024px);
	height: clamp(320px, calc(100% - 120px), 768px);
}

dialog > section
{
	gap: 4px;
	padding: 4px;
	display: grid;
	align-items: stretch;
	justify-items:stretch;
	align-content: stretch;
	justify-content: stretch;
	grid-template-rows: 40px auto;
}

div {
	overflow: auto;
}