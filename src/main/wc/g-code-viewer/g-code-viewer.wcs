* {
	box-sizing: border-box;
}

:host(*) {
	width: 100%;
	min-width: 0;
	display: grid;
	font-size: 10px;
	grid-template-rows: auto auto;
	border: 1px solid var(--main4, #F0F0F0);
}

#code-pane {
	min-width: 0;
	padding: 10px;
	overflow: auto;
	background-color: var(--hovered);
	border-bottom: 1px solid var(--main3, #F8F8F8);
}

#code-pane * {
	font-size: inherit;
	background-color: var(--hovered);
}

#html-pane {
	gap: 10px;
	min-width: 0;
	padding: 10px;
	display: flex;
	flex-direction: column;
	background-color: var(--main2);
}

.tag {
	color: var(--b1, #444488);
}

.key {
	color: var(--g1, #006600);
}

.val {
	color: var(--r1, #660000);
}