* {
	cursor: pointer;
	box-sizing: border-box;
}

:host
{
	margin: 0;
	padding: 0;
	width: auto;
	color: black;
	display: flex;
	z-index: 1000;
	overflow: auto;
	font-size: 14px;
	position: fixed;
	max-width: 50vw;
	max-height: 50vh;
	min-width: 220px;
	border-radius: 8px;
	align-items: stretch;
	flex-direction: column;
	background-color: #FFFFFF;
	box-shadow: 3px 10px 15px rgba(0, 0, 0, 0.1);
}

a, button
{
	gap: 12px;
	padding: 10px 16px;
	display: flex;
	color: inherit;
	flex-basis: 16px;
	font-size: inherit;
	align-items: center;
	white-space: nowrap;
	text-decoration: none;
	justify-content: space-between;
	border-radius: 4px;
	transition: background-color 0.2s ease, padding 0.2s ease;
}

a:hover,
button:hover
{
	background-color: var(--hovered, #FFFACD);
	padding-left: 20px;
}

a:focus,
button:focus
{
	outline: none;
	box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
}

label {
	flex-grow: 1;
	font-weight: 600;
}

a[data-icon]::before,
button[data-icon]::before
{
	font-family: gate;
	content: attr(data-icon);
}

a[submenu]::after,
button[submenu]::after
{
	color: #888;
	font-size: 12px;
	content: '\\2207';
	font-family: gate;
	margin-left: 8px;
}

a, button {
	transition: all 0.2s ease;
}

:host {
	padding: 10px;
	border-radius: 10px;
	box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}