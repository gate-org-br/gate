/* global customElements */

import anchor from './anchor.js';

customElements.define("g-more-menu", class extends HTMLElement
{
	constructor()
	{
		super();
		this.attachShadow({mode: 'open'});
		this.shadowRoot.appendChild(template.content.cloneNode(true));

		let div = this.shadowRoot.querySelector("div");
		this.addEventListener("click", () => this.hide());
	}

	show(x, y, gap, ...positions)
	{
		let div = this.shadowRoot.querySelector("div");
		const target = {getBoundingClientRect: () => ({x, y, left: x,
					top: y, right: x, bottom: y, width: 0, height: 0})};
		anchor(div, target, 0, ...positions).then(e =>
		{

			this.setAttribute("active", "");
			div.style.top = `${e.location.y}px`;
			div.style.left = `${e.location.x}px`;
		});
	}

	hide()
	{
		this.removeAttribute("active");
	}
});