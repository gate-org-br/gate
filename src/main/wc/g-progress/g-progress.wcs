:host(*) {
	width: 100%;
	flex-grow: 1;
	display: flex;
	align-items: stretch;
	background-color: var(--main3, #DDDDDD);
}

:host(*)::before {
	content: "";
	animation-fill-mode: both;
	background-color: var(--base1, #2f5674);
	animation: progress 2s infinite ease-in-out;
}

@keyframes progress {
	0% {
		flex-basis: 0;
	}

	100% {
		flex-basis: 100%;
	}
}