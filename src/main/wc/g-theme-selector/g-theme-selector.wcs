* {
	box-sizing: border-box;

}

:host(*) {
	gap: 12px;
	display: flex;
	color: inherit;
	flex-shrink: 0;
	font-size: 16px;
	cursor: pointer;
	align-items: center;
	justify-content: center;
}

:host::before
{
	content: '\\2203';
	font-family: 'gate';
}

:host([value='true'])::before
{
	content: '\\2164';
}

@media (prefers-color-scheme: dark)
{
	content: '\\2164';
	
	:host([value='true'])::before
	{
		content: '\\2203';
	}
}